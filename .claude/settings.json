{
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/g0amer/Desktop/thesis/03_Incremental_Learning_FLAIR/.venv/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/g0amer/Desktop/thesis/03_Incremental_Learning_FLAIR/.venv/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}